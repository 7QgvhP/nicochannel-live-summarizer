# ── 機密情報 ────────────────────────────────
# APIキー（雛形は .env.example）
/.env

# 専用ブラウザのプロファイル（ログインセッション・Cookie を含む）
/.browser-profile/

# ── 個人データ ──────────────────────────────
# 録音・録画・文字起こし・要約（有料配信の内容。再配布不可）
/archive/
/test_recording_*

# ── 依存パッケージ・生成物 ──────────────────
/.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── 環境依存 ────────────────────────────────
# ショートカット（ローカルの絶対パスを含む）
*.lnk
